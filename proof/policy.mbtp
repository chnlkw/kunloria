// proof/policy.mbtp — logic side of the verified decision core.
//
// Predicates here are specifications; lemmas are proof obligations that
// `moon prove` discharges with external SMT solvers (z3 / cvc5 / alt-ergo
// via Why3). See docs/verification.md for how to run the verifier.

///| `role` is the administrator role (code 0).
predicate is_admin(role : Int) {
  role == 0
}

///| `role` is the reader role (code 1).
predicate is_reader(role : Int) {
  role == 1
}

///| `role` is the writer role (code 2).
predicate is_writer(role : Int) {
  role == 2
}

///| `kind` is the write action kind (code 1).
predicate is_write(kind : Int) {
  kind == 1
}

///| `kind` is the read action kind (code 0).
predicate is_read(kind : Int) {
  kind == 0
}

///| `role` carries no role at all (code 3).
predicate is_no_role(role : Int) {
  role == 3
}

///| Anything that is not the administrator role.
predicate non_admin(role : Int) {
  role != 0
}

///| An Admin is always allowed, whatever the action and prefix.
predicate admin_ok(role : Int, result : Bool) {
  is_admin(role) → result
}

///| A Reader is never allowed a write action.
predicate reader_no_write(role : Int, kind : Int, result : Bool) {
  is_reader(role) && is_write(kind) → !result
}

///| A Writer is never allowed a read action.
predicate writer_no_read(role : Int, kind : Int, result : Bool) {
  is_writer(role) && is_read(kind) → !result
}

///| A non-admin role is denied when the group prefix does not match.
predicate prefix_required(role : Int, prefix_ok : Bool, result : Bool) {
  non_admin(role) && !prefix_ok → !result
}

///| A subject without a role is always denied.
predicate no_role_denied(role : Int, result : Bool) {
  is_no_role(role) → !result
}

///|
/// The security invariant of the Kunloria decision core: every clause of
/// docs/verification.md holds for `result`.
predicate decision_ok(role : Int, kind : Int, prefix_ok : Bool, result : Bool) {
  admin_ok(role, result) && reader_no_write(role, kind, result) && writer_no_read(role, kind, result) && prefix_required(role, prefix_ok, result) && no_role_denied(role, result)
}

///| Property 3 (statement form): without a matching group prefix no
/// non-admin role is allowed.
predicate group_isolated(role : Int, kind : Int) {
  non_admin(role) → decide(role, kind, false) == false
}

///| Property 1: a Reader can never obtain a write grant, whatever the prefix.
lemma reader_never_writes(prefix_ok : Bool) where {
  proof_ensure: decide(1, 1, prefix_ok) == false,
} {}

///| Property 2: an Admin is always allowed, for any action kind.
lemma admin_always_allowed(kind : Int, prefix_ok : Bool) where {
  proof_ensure: decide(0, kind, prefix_ok) == true,
} {}

///| Property 3: without a matching group prefix no non-admin role is allowed.
lemma group_isolation(role : Int, kind : Int) where {
  proof_ensure: group_isolated(role, kind),
} {}
